#!/usr/bin/env python3
"""mem-slot-guard — Claude Code PreToolUse(Bash) 검사: 무거운 명령이 메모리 자리표(mem-slot) 없이 오면 막는다.

막는 것(따옴표 안 글자는 보지 않음): tsc -b/--build · vite build · react-scripts build · next build · ng build
  · npm/pnpm/yarn (run) build[:이름] · 안드로이드 에뮬레이터(emulator -avd/@) · playwright test
통과: 명령에 `mem-slot run` 이 있음 · npm/yarn/pnpm build 인데 그 폴더 package.json 의 그 스크립트가 이미 mem-slot 으로 감쌈.
막을 때: 종료 2 + 그대로 쓸 명령을 알려 줌. 검사 자체가 오류면 통과(작업방을 세우지 않음).
켜는 법: docs/OPERATIONS.md 8절 · 시험: bash kit/bin/mem-slot-guard.test.sh
"""
import json, os, re, shlex, sys

SLOT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "mem-slot")   # 같은 폴더의 mem-slot (공개판 kit/bin 에서도 그대로)

HEREDOC = re.compile(r"<<-?\s*(['\"]?)([A-Za-z_][\w-]*)\1")

def strip_heredocs(s):
    """<<EOF … EOF 사이 글(파이썬 스크립트·파일 내용)은 명령이 아니라 보지 않는다."""
    lines, out, end = s.split("\n"), [], None
    for ln in lines:
        if end is not None:
            if ln.strip() == end:
                end = None
            continue
        out.append(ln)
        m = None
        for m in HEREDOC.finditer(strip_quotes(ln)):
            pass
        if m:
            end = m.group(2)
    return "\n".join(out)

def strip_quotes(s):
    out, q, i = [], None, 0
    while i < len(s):
        c = s[i]
        if q:
            if c == "\\" and q == '"':
                i += 2; continue
            if c == q:
                q = None; out.append(" ")
        elif c in "'\"":
            q = c
        else:
            out.append(c)
        i += 1
    return "".join(out)

START = r"(?:^|[;&|(\n]|\bthen\b|\bdo\b|\bexec\b|\bnpx\s|\btime\s|\btimeout\s+(?:-\S+\s+)*\S+\s|\bnice\s(?:-n\s*-?\d+\s)?|\benv\s|\w+=\S*\s)\s*"
PKG = re.compile(START + r"(?:\S*/)?(npm|pnpm|yarn)\s+((?:--?\S+\s+\S*\s+)*?)(?:run(?:-script)?\s+)?(build(?::[\w.-]+)?)(?=\s|$|[;&|)])")
HEAVY = [
    ("tsc", re.compile(START + r"(?:\S*/)?tsc\s+(?:\S+\s+)*?(?:-b|--build)\b")),
    ("vite", re.compile(START + r"(?:\S*/)?vite\s+build\b")),
    ("react-scripts", re.compile(START + r"(?:\S*/)?react-scripts\s+(?:--\S+\s+)*build\b")),
    ("next", re.compile(START + r"(?:\S*/)?next\s+build\b")),
    ("ng", re.compile(START + r"(?:\S*/)?ng\s+build\b")),
    ("emulator", re.compile(START + r"(?:\S*/)?emulator\s+(?:-avd\b|@)")),
    ("playwright", re.compile(START + r"(?:\S*/)?playwright\s+test\b")),
]

def where(cmd, cwd, upto):
    """명령 안 마지막 `cd X` (upto 앞) 를 cwd 에 맞춰 푼다."""
    d = cwd
    for m in re.finditer(r"(?:^|[;&|(]\s*)cd\s+([^\s;&|)]+)", cmd[:upto]):
        p = os.path.expanduser(m.group(1))
        d = p if os.path.isabs(p) else os.path.normpath(os.path.join(d, p))
    return d

def script_wrapped(d, name):
    try:
        with open(os.path.join(d, "package.json")) as f:
            s = json.load(f).get("scripts", {}).get(name, "")
        return "mem-slot" in s
    except Exception:
        return False

def mb_for(path, kind):
    if kind == "emulator": return 4500, "emulator"
    if kind == "playwright": return 1000, "chrome"
    return 3000, "build"

def main():
    try:
        data = json.load(sys.stdin)
    except Exception:
        return 0
    if data.get("tool_name") != "Bash":
        return 0
    raw = (data.get("tool_input") or {}).get("command") or ""
    cwd = data.get("cwd") or os.getcwd()
    if "mem-slot run" in raw or "mem-slot status" in raw:
        return 0
    cmd = strip_quotes(strip_heredocs(raw))
    hit = None
    for m in PKG.finditer(cmd):
        opts = m.group(2) or ""
        pm = re.search(r"--prefix\s+(\S+)", opts)
        d = where(cmd, cwd, m.start())
        if pm:
            p = os.path.expanduser(pm.group(1)); d = p if os.path.isabs(p) else os.path.normpath(os.path.join(d, p))
        if not script_wrapped(d, m.group(3)):
            hit = ("npm", d, m.group(0).strip(" ;&|(\n")); break
    if not hit:
        for kind, rx in HEAVY:
            m = rx.search(cmd)
            if m:
                hit = (kind, where(cmd, cwd, m.start()), m.group(0).strip(" ;&|(\n")); break
    if not hit:
        return 0
    kind, d, what = hit
    mb, name = mb_for(d, kind)
    sys.stderr.write(
        f"[메모리 자리표] 막음: «{what}» 는 무거운 작업이라 서버 공용 메모리 자리표를 거쳐야 합니다 "
        f"(빌드 여러 개가 겹쳐 서버 메모리가 바닥나는 일을 막음).\n"
        f"이렇게 다시 실행하세요 (차례가 올 때까지 기다림 · 우회 금지):\n"
        f"  {SLOT} run {name} {mb} -- <원래 명령>\n"
        f"예: {SLOT} run {name} {mb} -- bash -c {shlex.quote(raw.strip())}\n"
        f"몫(MB)은 그 작업의 실측 정점+15% — 지금 자리 상태: {SLOT} status\n"
        f"package.json 의 build 스크립트를 mem-slot 으로 감싸 두면 npm run build 는 그대로 통과합니다.\n"
    )
    return 2

if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception:
        sys.exit(0)
