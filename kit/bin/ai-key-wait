#!/usr/bin/env bash
# ai-key-wait — 짧은 claude 명령(agents·auth status·--bg …) 앞에 둔다
#   Claude 8시간 열쇠가 5분 안에 끝나면 어떤 claude 명령이든 갱신을 시작하는데, 짧은 명령은 저장 전에 끝나 갱신 열쇠를 죽인다
#   (board/key-window.js 머리말). 만료 6분 안이면 상황판이 갱신을 끝낼 때까지 기다린다(최대 8분).
#   상황판이 꺼져 갱신이 안 되면 4분 전에 끝까지 기다리는 명령(가벼운 모델 한 마디 claude -p ping) 하나로 직접 갱신한다.
#   1년 열쇠(CLAUDE_CODE_OAUTH_TOKEN)·로그인 없음·~/.claude-cred-guard/KEYWIN-OFF 이면 바로 통과. 늘 종료 0.
[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && exit 0
[ -e "$HOME/.claude-cred-guard/KEYWIN-OFF" ] && exit 0
left() { python3 - "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json" <<'PY' 2>/dev/null || echo 999999
import json,sys,time
try: a=json.load(open(sys.argv[1])).get("claudeAiOauth") or {}
except Exception: a={}
e=a.get("expiresAt") or 0
print(int(e/1000-time.time()) if e and len(a.get("refreshToken") or "")>20 else 999999)
PY
}
cap=480; curl -s -m 2 -o /dev/null http://127.0.0.1:8800/ 2>/dev/null && cap=150
end=$(( $(date +%s) + cap )); did=0
while :; do
  l=$(left)
  [ "$l" -gt 360 ] && exit 0
  [ "$(date +%s)" -ge "$end" ] && exit 0
  if [ "$l" -le 240 ] && [ $did = 0 ]; then did=1; timeout 300 claude -p --no-session-persistence --model haiku --tools '' --strict-mcp-config --system-prompt 'Reply with OK only.' ping >/dev/null 2>&1 </dev/null; continue; fi
  sleep 5
done
